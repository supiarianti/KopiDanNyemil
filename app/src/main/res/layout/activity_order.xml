<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Bagian Atas: Title & Input Fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <!-- Input Nama Lengkap -->
        <EditText
            android:id="@+id/etNamaLengkap"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/edit_text_background"
            android:hint="Nama Lengkap"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textSize="14sp"/>

        <!-- Input Alamat -->
        <EditText
            android:id="@+id/etAlamat"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/edit_text_background"
            android:gravity="top|start"
            android:hint="Alamat"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:textColor="#000000"
            android:textSize="14sp"/>

        <!-- Input Patokan atau Detail Lengkap -->
        <EditText
            android:id="@+id/etPatokan"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/edit_text_background"
            android:gravity="top|start"
            android:hint="Patokan atau detail lengkap"
            android:padding="16dp"
            android:inputType="textMultiLine"
            android:textColor="#000000"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Tombol Order dan Kirim di Bawah -->
    <Button
        android:id="@+id/btnOrderKirim"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_black"
        android:text="Order dan Kirim"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>