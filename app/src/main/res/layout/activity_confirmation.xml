<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Bagian Konten Tengah (Sapaan, Logo OK, & Pesan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- Sapaan di Atas (Rata Kiri) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halo Nama,"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="start"
            android:layout_marginBottom="40dp"/>

        <!-- Lingkaran OK Hijau -->
        <TextView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/circle_ok_background"
            android:gravity="center"
            android:text="OK"
            android:textColor="#2E7D32"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- Pesan Konfirmasi -->
        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Terima kasih sudah memesan tunggu aja sebentar kurir kami segera mengantarkan pesananmu!"
            android:textColor="#555555"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Tombol Oke di Bagian Bawah -->
    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_black"
        android:text="Oke"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>